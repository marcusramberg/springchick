@@ -74,6 +74,10 @@ static uint32_t height, normal_height, landscape_height;
 static int rounding = DEFAULT_ROUNDING;
 static bool hidden = false;
 static bool im_auto = false;
+/* Re-entrancy state for show()/hide(); see the comment in show(). */
+static bool showing = false;
+static bool hide_pending = false;
+static bool restart_pending = false;

 /* event handler prototypes */
 static void wl_pointer_enter(void *data, struct wl_pointer *wl_pointer,
@@ -587,6 +591,14 @@ layer_surface_configure(void *data, struct zwlr_layer_surface_v1 *surface,
     // Not what we expected, or redimension, refresh and restart
     if (keyboard.w != w || keyboard.h != h) {
         zwlr_layer_surface_v1_ack_configure(surface, serial);
+        /* This runs from a wl_display_roundtrip() inside show() when the
+         * compositor answers the probe surface. Restarting from there would
+         * re-enter show() and orphan the surface it is halfway through
+         * building, so defer the restart to the end of show(). */
+        if (showing) {
+            restart_pending = true;
+            return;
+        }
         hide();
         show();
